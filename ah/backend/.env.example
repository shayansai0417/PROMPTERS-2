# Server Port (Cloud platforms like Render/Railway automatically inject PORT)
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated, or * for all)
CORS_ORIGINS=*

# Optional Free AI Keys (Choose either Google Gemini or Groq):
# 1. Google Gemini API (100% Free - Get key at https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Groq Cloud API (100% Free - Get key at https://console.groq.com/)
GROQ_API_KEY=

